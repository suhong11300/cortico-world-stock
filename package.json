{
  "name": "cortico-world-stock",
  "version": "0.2.0",
  "type": "module",
  "description": "Cortico World: market briefs for a desktop companion — A-share and US indices, a configurable index list, optional holdings P&L, and copy rewritten in the persona you set",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "stock",
    "market",
    "index",
    "ashare",
    "us-stock",
    "companion"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "拟股喵喵",
    "icon": "icon.svg",
    "screenshots": [
      "screenshots/brief.svg",
      "screenshots/us-brief.svg",
      "screenshots/persona.svg",
      "screenshots/setup.svg"
    ],
    "tags": [
      "companion",
      "internet",
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "拟股喵喵",
        "description": "盯住你关注的市场:先按当地时区定好时间,早盘尾盘按窗口播报涨跌;A 股或美股指数清单都能自己配,接上账户还能只播盈亏,播报文案按你设的人格重写。"
      },
      "en": {
        "displayName": "Stock Meow",
        "description": "Watches the market you actually live in: A-share or US indices with a list you own, optional holdings P&L, and briefs rewritten in the persona you gave the companion."
      }
    },
    "describe": "describe.json"
  },
  "files": [
    "src",
    "icon.svg",
    "screenshots",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
