{
  "name": "cortico-world-stock",
  "version": "0.2.3",
  "type": "module",
  "description": "按本地时区在市场窗口播报行情。覆盖自选股与大盘指数，A 股与美股可切换，指数清单可自定义；接入账户后可选播报持仓盈亏；文案可按设定人格改写。",
  "license": "MIT",
  "author": "苏鸿与维基 (suhong11300)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhong11300/cortico-world-stock.git"
  },
  "homepage": "https://github.com/suhong11300/cortico-world-stock#readme",
  "bugs": {
    "url": "https://github.com/suhong11300/cortico-world-stock/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "stock",
    "market",
    "index",
    "ashare",
    "us-stock",
    "companion",
    "market-brief",
    "quote"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "拟股喵喵",
    "icon": "icon.svg",
    "screenshots": [
      "screenshots/brief.png",
      "screenshots/us-brief.png",
      "screenshots/persona.png",
      "screenshots/setup.png"
    ],
    "tags": [
      "companion",
      "internet"
    ],
    "locales": {
      "zh": {
        "displayName": "拟股喵喵",
        "description": "按本地时区在市场窗口播报行情。覆盖自选股与大盘指数，A 股与美股可切换，指数清单可自定义；接入账户后可选播报持仓盈亏；文案可按设定人格改写。"
      },
      "en": {
        "displayName": "Stock Meow",
        "description": "Briefs the market in windows of your local time zone. Covers a watchlist and indices, A-share or US, with a configurable index list; optional holdings P&L once an account is connected; copy can be rewritten in the persona you set."
      }
    },
    "describe": "describe.json"
  },
  "files": [
    "src",
    "icon.svg",
    "screenshots/*.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
