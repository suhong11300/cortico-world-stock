{
  "name": "cortico-world-stock",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: A-share market briefs for a desktop companion, with a configurable quote source and optional holdings",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "stock",
    "ashare",
    "market",
    "companion"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "拟股喵喵",
    "icon": "icon.svg",
    "screenshots": [
      "screenshots/brief.svg",
      "screenshots/setup.svg"
    ],
    "tags": [
      "companion",
      "internet",
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "拟股喵喵",
        "description": "盯住你关注的 A 股:先确定时区与当前时间,早盘尾盘按窗口播报涨跌,播完追问要不要细看;行情源与持仓都能自己配。"
      },
      "en": {
        "displayName": "Stock Meow",
        "description": "Watches your A-share watchlist and briefs you near the morning and afternoon closes in your own time zone, then asks whether you want the details."
      }
    },
    "describe": "describe.json"
  },
  "files": [
    "src",
    "icon.svg",
    "screenshots",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
